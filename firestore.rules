rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validUserProfile() {
      return request.resource.data.email is string
        && request.resource.data.email.matches('.*@.*\\..*')
        && request.resource.data.displayName is string
        && request.resource.data.createdAt is timestamp;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validUserProfile() && request.resource.data.email == request.auth.token.email;
      allow update: if isOwner(uid)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /savedPlaces/{placeId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.placeId == placeId
          && request.resource.data.savedAt is timestamp;
        allow delete: if isOwner(uid);
      }

      match /favorites/{placeId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.placeId == placeId
          && request.resource.data.savedAt is timestamp;
        allow delete: if isOwner(uid);
      }

      match /savedExperiences/{experienceId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.experienceId == experienceId
          && request.resource.data.savedAt is timestamp;
        allow delete: if isOwner(uid);
      }

      match /favoriteExperiences/{experienceId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.experienceId == experienceId
          && request.resource.data.savedAt is timestamp;
        allow delete: if isOwner(uid);
      }

      match /trips/{tripId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.duration is number
          && request.resource.data.interests is list
          && request.resource.data.destinations is list
          && request.resource.data.travelerType is string
          && request.resource.data.itinerary is list
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.createdAt is timestamp;
        allow delete: if isOwner(uid);
      }

      match /bookingRequests/{bookingId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.userId == uid
          && request.resource.data.experienceId is string
          && request.resource.data.preferredDate is string
          && request.resource.data.guests is number
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt is timestamp;
        allow delete: if isOwner(uid);
      }
    }

    match /stories/{storyId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.author is string
        && request.resource.data.country is string
        && request.resource.data.content is string
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
